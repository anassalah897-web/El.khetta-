{
  "name": "yalla-nkhattat",
  "version": "0.1.0",
  "private": true,
  "description": "Group outing and trip planner for Egypt",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cf:dev": "wrangler dev",
